CLAUDE.md
settings.json
mcp.json
settings.local.json
.env
*.local.md

# Pi extension dependencies
node_modules/

# Python artifacts
__pycache__/
*.pyc
*.pyo

# Packaged skill archives (binary)
*.skill

# System files
.DS_Store
*.swp
*.log
*.bak
